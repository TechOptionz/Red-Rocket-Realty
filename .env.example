# Copy to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.

# SFTP listing feed (LockedOn uploads REAXML here)
SFTP_HOST=170.64.245.189
SFTP_PORT=22
SFTP_USER=lockedon
SFTP_PASSWORD=
SFTP_DIR=/upload
# Optional: move processed files here (folder must exist on the server)
SFTP_ARCHIVE_DIR=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Feed cron: Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/feed/sync. Any long random string.
CRON_SECRET=
# Public site URL (Open Graph images; lets a CLI import refresh the live site)
SITE_URL=
